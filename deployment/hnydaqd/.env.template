# =============================================================================
# HNYDAQD Production Environment Template
# Copy this file to .env.hnydaqd and fill every value. NEVER commit .env.hnydaqd.
# =============================================================================

# --- Encryption (REQUIRED) ---
# 64-char hex string (32 bytes). Generate with: openssl rand -hex 32
HNYDAQD_MASTER_KEY=

# --- Provider Policy ---
# "false" means: CONFIDENTIAL and above must route to PRIVATE provider.
# Do not set "true" unless you have an enterprise-safe contract in place.
HNYDAQD_ALLOW_EXTERNAL_PROVIDERS=false

# --- Audit & DLP ---
# Set to "true" to fail hard on any DLP violation. Recommended for production.
HNYDAQD_STRICT_DLP=false

# --- Application Secrets (managed by Onyx, but listed for completeness) ---
# See deployment/docker_compose/env.template for the base values.
# These must not be copied from the base template; use real secrets in production.
POSTGRES_PASSWORD=
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
